extends includes/layout.pug

block content
  - const allPosts = blog_posts(page.posts)
  section.cy-home-posts(aria-label='最新文章')
    each post in allPosts
      article.cy-post-preview
        h2
          a(href=url_for(post.url))=post.title
        .cy-post-meta
          time(datetime=post.date)=post.date
          each tag in post.tags
            a.cy-tag(href=url_for('/tags/')+'?tag='+encodeURIComponent(tag))=tag
        p=post.excerpt
    if !allPosts.length
      p 暂无文章。
    if page.total > 1
      include includes/pagination.pug
